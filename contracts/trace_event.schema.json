{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "trace_event",
  "type": "object",
  "required": [
    "ts",
    "actor",
    "column",
    "text"
  ],
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string"
    },
    "column": {
      "enum": [
        "doing",
        "waiting",
        "did"
      ]
    },
    "text": {
      "type": "string",
      "description": "plain language, no jargon"
    },
    "tool": {
      "type": [
        "string",
        "null"
      ]
    },
    "detail": {
      "type": "object"
    }
  }
}
