    48	class AcmeMirrorClient:
    49	    """Serve the committed Acme Stay mirror, then defer to MirrorScrapeClient.
    50	
    51	    Unknown non-Acme URLs still raise through the inner gather client.
    52	    Never touches the network.
    53	    """
    54	
    55	    def __init__(self, mirrors_dir=None, inner=None):
    56	        self.mirrors_dir = (
    57	            Path(mirrors_dir) if mirrors_dir is not None else _DEFAULT_MIRRORS
    58	        )
    59	        self.inner = inner if inner is not None else MirrorScrapeClient(
    60	            mirrors_dir=self.mirrors_dir
    61	        )
    62	
    63	    def scrape_as_markdown(self, url):
    64	        if url in ACME_SITE_URLS:
    65	            path = self.mirrors_dir / _ACME_MIRROR
    66	            if not path.is_file():
    67	                raise ValueError("unknown url: %s" % url)
    68	            return path.read_text(encoding="utf-8")
    69	        return self.inner.scrape_as_markdown(url)
    70	
    71	    def search_engine(self, query):
    72	        return self.inner.search_engine(query)
