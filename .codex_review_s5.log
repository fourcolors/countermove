    34	_PLAN_TAG = re.compile(
    35	    r"(?is)<([a-z][a-z0-9]*)\b([^>]*\bdata-plan\s*=\s*['\"][^'\"]+['\"][^>]*)>"
    36	    r"(.*?)</\1\s*>"
    37	)
    38	_SEGMENT_TAG = re.compile(
    39	    r"(?is)<[a-z][a-z0-9]*\b([^>]*\bdata-segment\s*=\s*['\"][^'\"]+['\"][^>]*)>"
    40	)
    41	_ATTR = re.compile(r"""([:\w-]+)\s*=\s*(['"])(.*?)\2""")
