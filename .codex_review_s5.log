    43	    "oct": 10,
    44	    "october": 10,
    45	    "nov": 11,
    46	    "november": 11,
    47	    "dec": 12,
    48	    "december": 12,
    49	}
    50	
    51	_PRICE_VERB = re.compile(
    52	    r"(?i)\b(raise|increase|hike|cut|lower|drop|reduce|decrease|change|set)\b"
    53	)
    54	_PLAN_AFTER_VERB = re.compile(
    55	    r"(?i)\b(?:raise|increase|hike|cut|lower|drop|reduce|decrease|change|set)\s+"
    56	    r"(?:the\s+)?([A-Za-z][A-Za-z0-9_-]*)"
    57	)
    58	_PLAN_STOPWORDS = frozenset(
    59	    {
    60	        "prices",
    61	        "price",
    62	        "plan",
    63	        "plans",
    64	        "our",
    65	        "my",
    66	        "a",
    67	        "an",
    68	        "it",
    69	        "this",
    70	        "that",
    71	        "from",
    72	        "to",
    73	        "by",
    74	        "for",
    75	        "on",
    76	        "your",
    77	    }
    78	)
    79	_FROM_TO = re.compile(
    80	    r"(?i)from\s+\$?\s*(\d+(?:\.\d+)?)\s+to\s+\$?\s*(\d+(?:\.\d+)?)"
    81	)
    82	_TO_PRICE = re.compile(r"(?i)\bto\s+\$?\s*(\d+(?:\.\d+)?)\b")
    83	_QUESTION_OPENER = re.compile(
    84	    r"(?i)^\s*(should|could|would|can|may|shall|do|does|did|is|are|was|"
    85	    r"were|what|why|how|when|who|whom|which)\b"
    86	)
    87	_NEXT_WEEKDAY = re.compile(
    88	    r"(?i)\bnext\s+(monday|tuesday|wednesday|thursday|friday|saturday|sunday)\b"
    89	)
    90	_ISO_DATE = re.compile(r"\b(20\d{2}-\d{2}-\d{2})\b")
    91	_MONTH_DAY = re.compile(
    92	    r"(?i)\b(?:on\s+)?("
    93	    r"jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|jun(?:e)?|"
    94	    r"jul(?:y)?|aug(?:ust)?|sep(?:t(?:ember)?)?|oct(?:ober)?|"
    95	    r"nov(?:ember)?|dec(?:ember)?"
    96	    r")\s+(\d{1,2})(?:,?\s*(\d{4}))?"
    97	)
    98	
    99	_QUESTION_REPLY = (
   100	    "Tell me a specific price change, like: Raise Pro from $49 to $59."
   101	)
   102	_OUT_OF_SCOPE_REPLY = (
   103	    "Only price moves on one plan are supported today. "
   104	    "Describe a price change, like: Raise Pro from $49 to $59."
   105	)
