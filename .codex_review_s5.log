    15	class ToolRefused(Exception):
    16	    """Raised when a tool is not on the allowlist or is not registered."""
    17	
    18	    def __init__(self, tool_name, reason):
    19	        self.tool_name = tool_name
    20	        self.reason = reason
    21	        super().__init__(reason)
