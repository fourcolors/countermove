    75	def draft_company(url, client, router, session):
    76	    """Scrape the company site through the router and return a company dict.
    77	
    78	    Plans and prices come from structured extraction of the page. The three
    79	    known competitors are attached from the frozen company fixture. Missing
    80	    elasticity is filled with the labeled B2B default range.
    81	    """
    82	    if not isinstance(router, ToolRouter):
    83	        raise TypeError(
    84	            "draft_company requires a ToolRouter; the company site is never fetched around it"
    85	        )
    86	
    87	    def scrape_as_markdown(url):
    88	        return client.scrape_as_markdown(url)
    89	
    90	    router.register("brightdata.scrape_as_markdown", scrape_as_markdown)
    91	
    92	    emit(
    93	        session,
    94	        "orchestrator",
    95	        "doing",
    96	        "checking the company website",
    97	        tool="brightdata.scrape_as_markdown",
    98	        detail={"url": url},
    99	    )
   100	    content = router.call("brightdata.scrape_as_markdown", url=url)
   101	    if not isinstance(content, str):
   102	        content = "" if content is None else str(content)
   103	
   104	    if session.get("snapshots") is None:
   105	        session["snapshots"] = []
   106	    session["snapshots"].append(
   107	        {
   108	            "url": url,
   109	            "digest": hashlib.sha256(content.encode("utf-8")).hexdigest(),
   110	            "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
   111	        }
   112	    )
   113	
   114	    facts = extract_facts(content)
   115	    page_price = extract_price(content)
   116	    name = _extract_name(content) or "Company"
   117	    plans = _extract_plans(content, page_price)
   118	    segments = _extract_segments(content)
   119	    used_default_elasticity = False
   120	    for plan in plans:
   121	        plan["segments"] = [
   122	            _with_elasticity_defaults(copy.deepcopy(segment))
   123	            for segment in segments
   124	        ]
   125	        if any(item.get("assumed") for item in plan["segments"]):
   126	            used_default_elasticity = True
   127	
   128	    competitors = _known_competitors()
   129	    company = {"name": name, "plans": plans, "competitors": competitors}
   130	
   131	    emit(
   132	        session,
   133	        "orchestrator",
   134	        "did",
   135	        "read the company website",
   136	        tool="brightdata.scrape_as_markdown",
   137	        detail={
   138	            "url": url,
   139	            "price": facts.get("price") if facts.get("price") is not None else page_price,
   140	        },
   141	    )
   142	    emit(
   143	        session,
   144	        "orchestrator",
   145	        "did",
   146	        _plans_sentence(plans),
   147	        detail={"plans": [{"id": item["id"], "price": item["price"]} for item in plans]},
   148	    )
   149	    if used_default_elasticity:
   150	        emit(
   151	            session,
   152	            "orchestrator",
   153	            "did",
   154	            "filled in a typical price-sensitivity range because none was listed, and marked it assumed, not measured",
   155	            detail={"elasticity": copy.deepcopy(DEFAULT_ELASTICITY), "assumed": True},
   156	        )
   157	    emit(
   158	        session,
   159	        "orchestrator",
   160	        "did",
   161	        "added the three known competitors with their listed prices",
   162	        detail={"competitors": copy.deepcopy(competitors)},
   163	    )
   164	
   165	    session["company"] = company
   166	    return company
