    10	class CsvMergeError(ValueError):
    11	    """Raised when a CSV row cannot be applied. The message lists every problem."""
    12	
    13	
    14	def merge_csv(company, csv_text):
    15	    """Update matching segments in place and return unmatched rows.
    16	
    17	    Matching is by segment id (case-insensitive) across every plan.
    18	    Unmatched rows are returned for the user to assign or discard.
    19	    Malformed rows abort the merge with CsvMergeError; company is unchanged.
    20	    """
    21	    if not isinstance(company, dict):
    22	        raise TypeError("company must be an object")
    23	    if not isinstance(csv_text, str):
    24	        raise TypeError("csv_text must be a string")
    25	
    26	    rows, problems = _parse_rows(csv_text)
    27	    if problems:
    28	        raise CsvMergeError(_loud_problems(problems))
    29	
    30	    index = _segment_index(company)
    31	    unmatched = []
    32	    updates = []
    33	    for row in rows:
    34	        key = row["segment"].lower()
    35	        targets = index.get(key)
    36	        if not targets:
    37	            unmatched.append(
    38	                {
    39	                    "segment": row["segment"],
    40	                    "customers": row["customers"],
    41	                    "monthly_churn": row["monthly_churn"],
    42	                }
    43	            )
    44	            continue
    45	        updates.append((targets, row))
    46	
    47	    for targets, row in updates:
    48	        for segment in targets:
    49	            segment["customers"] = row["customers"]
    50	            segment["monthly_churn"] = row["monthly_churn"]
