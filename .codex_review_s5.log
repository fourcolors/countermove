    24	class ToolRouter:
    25	    """Dispatch only allowlisted, registered callables. Every other request is refused and traced."""
    26	
    27	    def __init__(self, session):
    28	        self.session = session
    29	        self._tools = {}
    30	
    31	    def register(self, name, fn):
    32	        if name not in ALLOWLIST:
    33	            self._refuse(name, "that tool is not on the allowed list")
    34	        if not callable(fn):
    35	            raise TypeError("tool must be callable")
    36	        self._tools[name] = fn
    37	
    38	    def call(self, name, **kwargs):
    39	        if name not in ALLOWLIST:
    40	            self._refuse(name, "that tool is not on the allowed list")
    41	        if name not in self._tools:
    42	            self._refuse(name, "that tool is not registered")
    43	        return self._tools[name](**kwargs)
    44	
    45	    def _refuse(self, name, reason):
    46	        emit(
    47	            self.session,
    48	            "orchestrator",
    49	            "did",
    50	            "refused a tool that is not allowed",
    51	            tool=name,
    52	            detail={"reason": reason},
    53	        )
    54	        raise ToolRefused(name, reason)
