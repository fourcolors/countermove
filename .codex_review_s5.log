    31	    t = schema.get("type")
    32	    if t is not None:
    33	        types = t if isinstance(t, list) else [t]
    34	        if not any(_type_ok(value, item) for item in types):
    35	            return [f"{path}: expected {types}, got {type(value).__name__}"]
    36	    if "const" in schema and value != schema["const"]:
    37	        errors.append(f"{path}: expected const {schema['const']!r}")
    38	    if "enum" in schema and value not in schema["enum"]:
    39	        errors.append(f"{path}: {value!r} not in enum")
    40	    if "pattern" in schema and isinstance(value, str):
    41	        if not re.search(schema["pattern"], value):
    42	            errors.append(f"{path}: does not match {schema['pattern']}")
    43	    if "anyOf" in schema:
    44	        branches = [validate(value, sub, path) for sub in schema["anyOf"]]
    45	        if not any(not b for b in branches):
    46	            errors.append(f"{path}: no anyOf branch matched")
    47	    for sub in schema.get("allOf", []):
