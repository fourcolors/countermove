   108	class Rejection:
   109	    """Typed refusal. kind is 'question', 'out_of_scope', or 'unknown_plan'."""
   110	
   111	    def __init__(self, kind, reply):
   112	        self.kind = kind
   113	        self.reply = reply
   114	
   115	    def __repr__(self):
   116	        return "Rejection(kind=%r, reply=%r)" % (self.kind, self.reply)
   117	
   118	    def __eq__(self, other):
   119	        return (
   120	            isinstance(other, Rejection)
   121	            and self.kind == other.kind
   122	            and self.reply == other.reply
   123	        )
