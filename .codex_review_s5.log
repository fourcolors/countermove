    54	def _parse_rows(csv_text):
    55	    problems = []
    56	    if not csv_text.strip():
    57	        problems.append("the CSV is empty")
    58	        return [], problems
    59	
    60	    handle = io.StringIO(csv_text)
    61	    try:
    62	        reader = csv.DictReader(handle)
    63	    except csv.Error as exc:
    64	        problems.append("the CSV could not be read: %s" % exc)
    65	        return [], problems
    66	
    67	    if not reader.fieldnames:
    68	        problems.append("the CSV has no header row")
    69	        return [], problems
    70	
    71	    header_map = {}
    72	    for name in reader.fieldnames:
    73	        if name is None:
    74	            continue
    75	        key = _norm_header(name)
    76	        if key:
    77	            header_map[key] = name
    78	    missing = [column for column in REQUIRED_COLUMNS if column not in header_map]
    79	    if missing:
    80	        problems.append(
    81	            "CSV must have columns segment, customers, monthly_churn (missing: %s)"
    82	            % ", ".join(missing)
    83	        )
    84	        return [], problems
    85	
    86	    rows = []
    87	    for line_number, raw in enumerate(reader, start=2):
    88	        if raw is None:
    89	            problems.append("line %s is malformed" % line_number)
    90	            continue
    91	        if _row_blank(raw):
    92	            continue
    93	        if None in raw:
    94	            problems.append(
    95	                "line %s has more fields than the header"
    96	                % line_number
    97	            )
    98	            continue
    99	        segment = raw.get(header_map["segment"])
   100	        customers_raw = raw.get(header_map["customers"])
   101	        churn_raw = raw.get(header_map["monthly_churn"])
   102	        segment_id = (segment or "").strip()
   103	        if not segment_id:
   104	            problems.append("line %s is missing a segment id" % line_number)
   105	            continue
   106	        customers, customers_error = _parse_customers(customers_raw)
   107	        if customers_error:
   108	            problems.append("line %s: %s" % (line_number, customers_error))
   109	            continue
   110	        churn, churn_error = _parse_churn(churn_raw)
   111	        if churn_error:
   112	            problems.append("line %s: %s" % (line_number, churn_error))
   113	            continue
   114	        rows.append(
   115	            {
   116	                "segment": segment_id,
   117	                "customers": customers,
   118	                "monthly_churn": churn,
   119	            }
   120	        )
   121	    return rows, problems
   122	
   123	
   124	def _loud_problems(problems):
   125	    if len(problems) == 1:
   126	        return "CSV rejected: %s" % problems[0]
   127	    numbered = "; ".join(problems)
   128	    return "CSV rejected (%s problems): %s" % (len(problems), numbered)
   129	
   130	
   131	def _norm_header(name):
   132	    return re.sub(r"[^a-z0-9]+", "_", name.strip().lower()).strip("_")
   133	
   134	
   135	def _row_blank(raw):
   136	    values = [value for value in raw.values() if value is not None]
   137	    return not any(str(value).strip() for value in values)
   138	
   139	
   140	def _parse_customers(raw):
   141	    if raw is None or str(raw).strip() == "":
   142	        return None, "customers is missing"
   143	    text = str(raw).strip().replace(",", "")
   144	    try:
   145	        number = float(text)
   146	    except ValueError:
   147	        return None, "customers %r is not a number" % raw
   148	    if number != number or number < 0:
   149	        return None, "customers %r is not a valid count" % raw
   150	    if number == int(number):
   151	        return int(number), None
   152	    return number, None
   153	
   154	
   155	def _parse_churn(raw):
   156	    if raw is None or str(raw).strip() == "":
   157	        return None, "monthly_churn is missing"
   158	    text = str(raw).strip()
   159	    try:
   160	        number = float(text)
   161	    except ValueError:
   162	        return None, "monthly_churn %r is not a number" % raw
   163	    if number != number or number < 0 or number > 1:
   164	        return None, "monthly_churn %r must be a fraction between 0 and 1" % raw
   165	    return number, None
   166	
   167	
   168	def _segment_index(company):
   169	    index = {}
   170	    for plan in company.get("plans") or []:
   171	        for segment in plan.get("segments") or []:
   172	            key = str(segment.get("id", "")).strip().lower()
   173	            if not key:
   174	                continue
   175	            index.setdefault(key, []).append(segment)
   176	    return index
