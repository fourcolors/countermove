   126	def parse_move(text, company, today=None):
   127	    """Return a move dict or a Rejection. Does not mutate company or any tree."""
   128	    if not isinstance(text, str) or not text.strip():
   129	        return Rejection("question", _QUESTION_REPLY)
   130	
   131	    stripped = text.strip()
   132	    if _is_question(stripped):
   133	        return Rejection("question", _QUESTION_REPLY)
   134	
   135	    from_price, to_price = _prices(stripped)
   136	    plan = _named_plan(stripped, company)
   137	
   138	    if _PRICE_VERB.search(stripped) and to_price is not None:
   139	        if plan is None:
   140	            return _unknown_plan(stripped, company)
   141	        if from_price is None:
   142	            from_price = _as_number(plan["price"])
   143	        effective = _effective_date(stripped, today)
   144	        return {
   145	            "plan": plan["id"],
   146	            "from": from_price,
   147	            "to": to_price,
   148	            "action": ACTION,
   149	            "effective": effective.isoformat(),
   150	        }
   151	
   152	    if _PRICE_VERB.search(stripped):
   153	        return Rejection("question", _QUESTION_REPLY)
   154	
   155	    return Rejection("out_of_scope", _OUT_OF_SCOPE_REPLY)
   156	
   157	
   158	def _is_question(text):
   159	    if text.endswith("?"):
   160	        return True
   161	    return bool(_QUESTION_OPENER.match(text))
   162	
   163	
   164	def _prices(text):
   165	    match = _FROM_TO.search(text)
   166	    if match:
   167	        return _as_number(match.group(1)), _as_number(match.group(2))
   168	    match = _TO_PRICE.search(text)
   169	    if match:
   170	        return None, _as_number(match.group(1))
   171	    return None, None
   172	
   173	
   174	def _named_plan(text, company):
   175	    plans = list(company.get("plans") or [])
   176	    mentioned = _mentioned_plan_token(text)
   177	    if mentioned is not None:
   178	        for plan in plans:
   179	            if str(plan.get("id", "")).strip().lower() == mentioned.lower():
   180	                return plan
   181	        return None
   182	    lowered = text.lower()
   183	    ranked = sorted(
   184	        plans, key=lambda item: len(str(item.get("id", ""))), reverse=True
   185	    )
   186	    for plan in ranked:
   187	        plan_id = str(plan.get("id", "")).strip()
   188	        if not plan_id:
   189	            continue
   190	        if re.search(r"\b%s\b" % re.escape(plan_id.lower()), lowered):
   191	            return plan
   192	    if len(plans) == 1:
   193	        return plans[0]
   194	    return None
   195	
   196	
   197	def _mentioned_plan_token(text):
   198	    match = _PLAN_AFTER_VERB.search(text)
   199	    if not match:
   200	        return None
   201	    token = match.group(1)
   202	    if token.lower() in _PLAN_STOPWORDS:
   203	        return None
   204	    return token
   205	
   206	
   207	def _unknown_plan(text, company):
   208	    names = []
   209	    for plan in company.get("plans") or []:
   210	        plan_id = str(plan.get("id", "")).strip()
   211	        if plan_id:
   212	            names.append(plan_id)
   213	    mentioned = _mentioned_plan_token(text)
   214	    if names:
   215	        listed = ", ".join(names)
   216	        if mentioned:
   217	            reply = (
   218	                "I will not guess a plan called %s; it is not on the company. "
   219	                "The plans I have are: %s. "
   220	                "Tell me which of those to change and the new price."
   221	            ) % (mentioned, listed)
   222	        else:
   223	            reply = (
   224	                "I will not guess a plan that is not on the company. "
   225	                "The plans I have are: %s. "
   226	                "Tell me which of those to change and the new price."
   227	            ) % listed
   228	    else:
   229	        reply = (
   230	            "I will not guess a plan that is not on the company. "
   231	            "Add a plan on the company card first, then tell me the price change."
   232	        )
   233	    return Rejection("unknown_plan", reply)
   234	
   235	
   236	def _effective_date(text, today):
   237	    today_date = _as_date(today)
   238	    weekday = _NEXT_WEEKDAY.search(text)
   239	    if weekday:
   240	        return _next_weekday(today_date, weekday.group(1))
   241	    iso = _ISO_DATE.search(text)
   242	    if iso:
   243	        return date.fromisoformat(iso.group(1))
   244	    month_day = _MONTH_DAY.search(text)
   245	    if month_day:
   246	        month = _MONTHS[month_day.group(1).lower()]
   247	        day = int(month_day.group(2))
   248	        year = int(month_day.group(3)) if month_day.group(3) else today_date.year
   249	        try:
   250	            resolved = date(year, month, day)
   251	        except ValueError:
   252	            return today_date + timedelta(days=DEFAULT_EFFECTIVE_DAYS)
   253	        if month_day.group(3) is None and resolved < today_date:
   254	            try:
   255	                resolved = date(year + 1, month, day)
   256	            except ValueError:
   257	                return today_date + timedelta(days=DEFAULT_EFFECTIVE_DAYS)
   258	        return resolved
   259	    return today_date + timedelta(days=DEFAULT_EFFECTIVE_DAYS)
   260	
   261	
   262	def _next_weekday(today_date, name):
   263	    target = _WEEKDAYS[name.lower()]
   264	    ahead = (target - today_date.weekday()) % 7
   265	    if ahead == 0:
   266	        ahead = 7
   267	    return today_date + timedelta(days=ahead)
   268	
   269	
   270	def _as_date(value):
   271	    if value is None:
   272	        return date.today()
   273	    if isinstance(value, datetime):
   274	        return value.date()
   275	    if isinstance(value, date):
   276	        return value
   277	    if isinstance(value, str):
   278	        return date.fromisoformat(value[:10])
   279	    raise TypeError("today must be a date")
   280	
   281	
   282	def _as_number(value):
   283	    number = float(value)
   284	    if number == int(number):
   285	        return int(number)
   286	    return number
