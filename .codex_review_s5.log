   175	def _extract_name(content):
   176	    match = _H1.search(content)
   177	    if match:
   178	        name = _plain(match.group(1))
   179	        if name:
   180	            return name
   181	    match = _TITLE.search(content)
   182	    if match:
   183	        name = _plain(match.group(1))
   184	        if name:
   185	            return name.split(" - ")[0].strip()
   186	    return None
   187	
   188	
   189	def _extract_plans(content, fallback_price):
   190	    plans = []
   191	    seen = set()
   192	    for match in _PLAN_TAG.finditer(content):
   193	        attrs = _attrs(match.group(2))
   194	        plan_id = (attrs.get("data-plan") or "").strip()
   195	        if not plan_id or plan_id.lower() in seen:
   196	            continue
   197	        body = match.group(3)
   198	        dollar = _DOLLAR.search(body)
   199	        if dollar:
   200	            price = _as_number(dollar.group(1))
   201	        elif fallback_price is not None:
   202	            price = _as_number(fallback_price)
   203	        else:
   204	            continue
   205	        plans.append({"id": plan_id, "price": price, "segments": []})
   206	        seen.add(plan_id.lower())
   207	    if not plans and fallback_price is not None:
   208	        raise ValueError(
   209	            "the page has a price but no plan name I can use; I will not guess a plan"
   210	        )
   211	    if not plans:
   212	        raise ValueError("I could not find a plan and price on that page")
   213	    return plans
   214	
   215	
   216	def _extract_segments(content):
   217	    segments = []
   218	    seen = set()
   219	    for match in _SEGMENT_TAG.finditer(content):
   220	        attrs = _attrs(match.group(1))
   221	        segment_id = (attrs.get("data-segment") or "").strip()
   222	        if not segment_id or segment_id.lower() in seen:
   223	            continue
   224	        customers = _optional_number(attrs.get("data-customers"), 0)
   225	        churn = _optional_number(attrs.get("data-monthly-churn"), 0)
   226	        segments.append(
   227	            {
   228	                "id": segment_id,
   229	                "customers": customers,
   230	                "monthly_churn": churn,
   231	            }
   232	        )
   233	        seen.add(segment_id.lower())
   234	    if not segments:
   235	        segments.append({"id": "customers", "customers": 0, "monthly_churn": 0})
   236	    return segments
   237	
   238	
   239	def _with_elasticity_defaults(segment):
   240	    if not _has_elasticity(segment.get("elasticity")):
   241	        segment["elasticity"] = copy.deepcopy(DEFAULT_ELASTICITY)
   242	        segment["assumed"] = True
   243	    if "cross_elasticity" not in segment:
   244	        segment["cross_elasticity"] = DEFAULT_CROSS_ELASTICITY
   245	    return segment
   246	
   247	
   248	def _has_elasticity(value):
   249	    if not isinstance(value, dict):
   250	        return False
   251	    return all(key in value for key in ("low", "mid", "high"))
   252	
   253	
   254	def _plans_sentence(plans):
   255	    if not plans:
   256	        return "did not find a plan on the company website"
   257	    parts = []
   258	    for plan in plans:
   259	        price = plan["price"]
   260	        shown = str(int(price)) if price == int(price) else str(price)
   261	        parts.append("the %s plan at $%s" % (plan["id"], shown))
   262	    if len(parts) == 1:
   263	        return "found %s" % parts[0]
   264	    return "found %s" % ", ".join(parts)
   265	
   266	
   267	def _attrs(blob):
   268	    found = {}
   269	    for match in _ATTR.finditer(blob or ""):
   270	        found[match.group(1).lower()] = html.unescape(match.group(3))
   271	    return found
   272	
   273	
   274	def _plain(text):
   275	    stripped = _TAGS.sub(" ", text or "")
   276	    stripped = html.unescape(stripped)
   277	    return re.sub(r"\s+", " ", stripped).strip()
   278	
   279	
   280	def _optional_number(raw, default):
   281	    if raw is None or str(raw).strip() == "":
   282	        return default
   283	    try:
   284	        return _as_number(raw)
   285	    except (TypeError, ValueError):
   286	        return default
   287	
   288	
   289	def _as_number(value):
   290	    number = float(value)
   291	    if number != number:
   292	        raise ValueError("not a number")
   293	    if number == int(number):
   294	        return int(number)
   295	    return number
     1	"""Merge a segment CSV into a drafted company summary."""
     2	
